{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deriv-email-ai:schema:email-output:0.2.0",
  "title": "Brokerage email output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "blocked",
        "ready_with_warnings",
        "ready_for_human_review"
      ]
    },
    "brief_interpretation": {
      "type": "string"
    },
    "missing_information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "message_strategy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "proposition": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_hierarchy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proof_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cta_strategy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "subject_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preheader_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "email": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "preheader": {
          "type": [
            "string",
            "null"
          ]
        },
        "headline": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_cta_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_cta_destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_disclosure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "qa_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/qa"
      }
    },
    "human_review_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "brief_interpretation",
    "missing_information",
    "conflicts",
    "claims",
    "qa_results",
    "human_review_required"
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "required_action": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "severity",
        "blocking",
        "required_action"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "wording": {
          "type": "string"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unsupported",
            "conflicting",
            "expired"
          ]
        },
        "qualification": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "required_action": {
          "type": "string"
        }
      },
      "required": [
        "wording",
        "status",
        "severity",
        "required_action"
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "warning",
            "not_applicable"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "check_id",
        "category",
        "result"
      ]
    }
  }
}
